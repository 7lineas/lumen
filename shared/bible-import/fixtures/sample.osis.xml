        <verse osisID="Gen.1.1">EN el principio crió <w lemma="strong:H430">Dios</w> los cielos y la tierra.<note>nota</note></verse>
        <verse sID="Gen.1.2" osisID="Gen.1.2"/>Y la tierra estaba desordenada y vacía.<verse eID="Gen.1.2"/>
      </chapter>
    </div>
    <div type="book" osisID="John">
      <chapter osisID="John.3">
        <verse osisID="John.3.16">Porque de tal manera amó Dios al mundo.</verse>
        <verse osisID="John.3.17">Porque no envió Dios á su Hijo al mundo.</verse>
