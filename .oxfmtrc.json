{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "dist/**",
    "dist-electron/**",
    "release/**",
    "data/**",
    "landing-dist/**",
    "**/*.tsbuildinfo"
  ]
}
