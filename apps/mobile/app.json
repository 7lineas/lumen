{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "scheme": "lumen",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.svlineas.lumen",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lumen se conecta al equipo de proyección en tu red local.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.svlineas.lumen",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-foreground.png",
        "backgroundColor": "#17130e"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#f7f2e8",
          "dark": {
            "backgroundColor": "#17130e"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Lumen usa la cámara para leer el código QR que muestra el equipo de proyección."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15afaaee-be3d-461b-8d2e-5ce9b25bfac1"
      }
    },
    "owner": "svlineas"
  }
}
