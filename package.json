{
  "name": "lumen",
  "version": "1.0.1",
  "description": "Lumen — versículos para iglesia (offline)",
  "author": "7Lineas",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "convert:bibles": "node scripts/convert-vpl.mjs",
    "build:bible-modules": "node scripts/build-bible-modules.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:win": "pnpm build && electron-builder --win --x64",
    "pack:win:portable": "pnpm build && electron-builder --win portable --x64",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "smoke:dev": "pnpm build && xvfb-run -a env ELECTRON_DISABLE_GPU=1 node scripts/capture-screenshots.mjs",
    "smoke:packaged": "xvfb-run -a env ELECTRON_DISABLE_GPU=1 node scripts/smoke-packaged.mjs",
    "landing": "node scripts/serve-landing.mjs",
    "landing:check": "node scripts/check-landing.mjs",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "electron-store": "^10.0.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.50.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.8"
  },
  "build": {
    "appId": "com.7lineas.lumen",
    "productName": "Lumen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "data/bibles",
        "to": "data/bibles",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/bible-modules",
        "to": "data/bible-modules",
        "filter": [
          "bibles-catalog.json"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ],
      "language": "3082"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Office",
      "executableName": "proyector-biblico"
    }
  }
}
