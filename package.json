{
  "name": "proyector-biblico",
  "version": "1.0.0",
  "description": "Proyector Bíblico — versículos para iglesia (offline)",
  "author": "Proyector Bíblico",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "sharp"]
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "convert:bibles": "node scripts/convert-vpl.mjs",
    "build:bible-modules": "node scripts/build-bible-modules.mjs",
    "prebuild": "pnpm convert:bibles",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:win": "pnpm build && electron-builder --win --x64",
    "pack:win:portable": "pnpm build && electron-builder --win portable --x64",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "smoke:dev": "pnpm build && xvfb-run -a env ELECTRON_DISABLE_GPU=1 node scripts/capture-screenshots.mjs",
    "smoke:packaged": "xvfb-run -a env ELECTRON_DISABLE_GPU=1 node scripts/smoke-packaged.mjs",
    "landing": "node scripts/serve-landing.mjs",
    "landing:check": "node scripts/check-landing.mjs",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "electron-store": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.8"
  },
  "build": {
    "appId": "org.iglesia.proyector-biblico",
    "productName": "Proyector Bíblico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "data/bibles",
        "to": "data/bibles",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/bible-modules",
        "to": "data/bible-modules",
        "filter": [
          "bibles-catalog.json"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ],
      "language": "3082"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": ["dir"],
      "category": "Office",
      "executableName": "proyector-biblico"
    }
  }
}
